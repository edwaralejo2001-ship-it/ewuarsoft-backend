# Configuración del Servidor
PORT=3000

# Conexión MySQL Local o Remota
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ewarsoft
DB_CONNECTION_LIMIT=10

# Para MySQL en la Nube (Aiven, TiDB Cloud, Clever Cloud, Railway)
# Asignar true para activar conexión segura SSL requerida por bases de datos remotas
DB_SSL=false

# Opcional: URL completa de conexión (usada por algunas plataformas como Railway o TiDB)
# DATABASE_URL=mysql://usuario:password@host:port/ewarsoft
