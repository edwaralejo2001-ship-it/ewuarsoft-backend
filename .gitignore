# ==========================================================
# .gitignore - EwuarSoft Backend (Tienda y Licores La Farra)
# ==========================================================

# Dependencias
node_modules/

# Variables de entorno y credenciales (NO subir a GitHub)
.env
.env.*
!.env.example
*.env

# Archivos de registro (Logs)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos del Sistema Operativo
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.DS_Store
.DS_Store?
._*

# Editores de código
.vscode/
.idea/
*.swp
*.tmp

# Archivos temporales y Postman
.postman/
postman/
test-system.js
